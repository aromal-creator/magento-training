<?xml version="1.0"?>
<!-- Picked up by "bin/magento cron:run", which the server crontab starts every minute -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="codilar_cron_demo_heartbeat" instance="Codilar\CronDemo\Cron\Heartbeat" method="execute">
            <!-- minute hour day-of-month month day-of-week: every minute -->
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
