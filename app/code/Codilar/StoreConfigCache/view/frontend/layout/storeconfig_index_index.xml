<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- cacheable="false": the full page cache must not keep a copy, or HIT/MISS would never change -->
            <block class="Magento\Framework\View\Element\Template"
                   name="codilar.store.config.cache"
                   template="Codilar_StoreConfigCache::values.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\StoreConfigCache\ViewModel\StoreConfigView</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
