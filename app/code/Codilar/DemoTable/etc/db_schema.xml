<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codilar_demo_table" resource="default" engine="innodb" comment="Codilar Demo Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Name"/>
        <column xsi:type="varchar" name="email" length="255" nullable="true" comment="Email"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1"
                comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CODILAR_DEMO_TABLE_EMAIL">
            <column name="email"/>
        </constraint>
        <index referenceId="CODILAR_DEMO_TABLE_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <table name="codilar_demo_order" resource="default" engine="innodb" comment="Codilar Demo Order">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" identity="true"
                comment="Order ID"/>
        <column xsi:type="int" name="demo_id" unsigned="true" nullable="false"
                comment="Demo Table Entity ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true"
                comment="Store ID"/>
        <column xsi:type="varchar" name="order_number" length="32" nullable="false" comment="Order Number"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="12" unsigned="false" nullable="false"
                default="0" comment="Amount"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <!-- Primary key: every row has a unique order_id -->
       <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <!-- Unique: no two rows may share an order_number -->
        <constraint xsi:type="unique" referenceId="CODILAR_DEMO_ORDER_ORDER_NUMBER">
            <column name="order_number"/>
        </constraint>
        <!-- Foreign key: demo_id must exist in codilar_demo_table; deleting the parent deletes its orders -->
        <constraint xsi:type="foreign" referenceId="CODILAR_DEMO_ORDER_DEMO_ID_CODILAR_DEMO_TABLE_ENTITY_ID"
                    table="codilar_demo_order" column="demo_id"
                    referenceTable="codilar_demo_table" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <!-- Foreign key: store_id must exist in store; deleting the store sets it to NULL -->
        <constraint xsi:type="foreign" referenceId="CODILAR_DEMO_ORDER_STORE_ID_STORE_STORE_ID"
                    table="codilar_demo_order" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="SET NULL"/>
        <!-- Index: a foreign key column needs one, and it speeds up "orders of demo X" lookups -->
        <index referenceId="CODILAR_DEMO_ORDER_DEMO_ID" indexType="btree">
            <column name="demo_id"/>
        </index>
    </table>

</schema>
