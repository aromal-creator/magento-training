<?xml version="1.0"?>
<!--
    Preference: wherever the storefront creates Magento's product price box
    (product page, category listing, widgets), it gets our subclass instead.

    Note: a preference replaces exactly this class. Configurable products use
    their own subclass (Magento\ConfigurableProduct\Pricing\Render\FinalPriceBox),
    which is not affected.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Catalog\Pricing\Render\FinalPriceBox"
                type="Codilar\PriceLabel\Pricing\Render\FinalPriceBox"/>
</config>
