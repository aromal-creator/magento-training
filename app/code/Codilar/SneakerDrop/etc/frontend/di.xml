<?xml version="1.0"?>
<!--
    Preference: the storefront cart model (every "Add to Cart" goes through its
    public addProduct()) is replaced by our subclass, which checks the
    per-customer limit first and then calls the original.
    Plugins declared on Magento\Checkout\Model\Cart still run on the subclass.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Checkout\Model\Cart"
                type="Codilar\SneakerDrop\Model\Cart"/>
</config>
