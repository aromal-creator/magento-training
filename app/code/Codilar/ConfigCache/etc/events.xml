<?xml version="1.0"?>
<!-- Fired after an admin saves a section in Stores > Configuration -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- General > General: store name, phone, country -->
    <event name="admin_system_config_changed_section_general">
        <observer name="codilar_config_cache_clear" instance="Codilar\ConfigCache\Observer\ClearConfigCache"/>
    </event>
    <!-- General > Store Email Addresses: store email -->
    <event name="admin_system_config_changed_section_trans_email">
        <observer name="codilar_config_cache_clear" instance="Codilar\ConfigCache\Observer\ClearConfigCache"/>
    </event>
</config>
