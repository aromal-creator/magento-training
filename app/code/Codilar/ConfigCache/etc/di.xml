<?xml version="1.0"?>
<!-- Registers the CLI commands: bin/magento codilar:config-cache:show / :clear -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="codilar_config_cache_show" xsi:type="object">Codilar\ConfigCache\Console\Command\ShowCommand</item>
                <item name="codilar_config_cache_clear" xsi:type="object">Codilar\ConfigCache\Console\Command\ClearCommand</item>
            </argument>
        </arguments>
    </type>
</config>
