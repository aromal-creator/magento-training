<?xml version="1.0"?>
<!-- Stores > Configuration > Codilar > Return Manager -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="codilar" translate="label" sortOrder="400">
            <label>Codilar</label>
        </tab>
        <section id="codilar_return_manager" translate="label" sortOrder="10" showInDefault="1">
            <label>Return Manager</label>
            <tab>codilar</tab>
            <resource>Codilar_ReturnManager::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable Return Manager</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>If No, the Return Manager menu is hidden and its pages are blocked. Saved returns are kept.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
