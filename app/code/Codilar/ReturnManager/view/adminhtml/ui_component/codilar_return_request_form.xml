<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codilar_return_request_form.codilar_return_request_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Return Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Codilar\ReturnManager\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="Codilar\ReturnManager\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save" class="Codilar\ReturnManager\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>codilar_return_request_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>codilar_return_request_form.codilar_return_request_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="codilar_return_request_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="returnmanager/request/save"/>
        </settings>
        <dataProvider class="Codilar\ReturnManager\Ui\DataProvider\ReturnRequestDataProvider"
                      name="codilar_return_request_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Return Details</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="order_id" sortOrder="10" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">32</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Order ID</label>
                <notice translate="true">The order number, e.g. 000000012</notice>
                <dataScope>order_id</dataScope>
            </settings>
        </field>
        <field name="product_sku" sortOrder="20" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">64</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Product SKU</label>
                <dataScope>product_sku</dataScope>
            </settings>
        </field>
        <field name="reason" sortOrder="30" formElement="select">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Return Reason</label>
                <dataScope>reason</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Codilar\ReturnManager\Model\Source\Reason"/>
                        <caption translate="true">-- Please Select --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="status" sortOrder="40" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">pending</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Return Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Codilar\ReturnManager\Model\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
