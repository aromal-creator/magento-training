<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="codilar.dashboard.products"
                   after="dashboard"
                   template="Codilar_DashboardProducts::product_list.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\DashboardProducts\ViewModel\ProductList</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
