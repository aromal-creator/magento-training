<?xml version="1.0"?>
<!-- Runs every day at 00:10 (server time): removes special prices whose end date has passed -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="codilar_special_price_cleanup"
             instance="Codilar\SpecialPriceCleanup\Cron\RemoveExpiredSpecialPrices"
             method="execute">
            <schedule>10 0 * * *</schedule>
        </job>
    </group>
</config>
