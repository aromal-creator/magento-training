/** @var \Codilar\OrderSuccessAlert\ViewModel\OrderAlert $viewModel */
$viewModel = $block->getData('view_model');
$text = $viewModel->takeAlertText();
if ($text === '') {
    return;
}
?>
<script type="text/x-magento-init">
    {
        "*": {
            "Codilar_OrderSuccessAlert/js/order-alert": {
                "title": "<?= $escaper->escapeJs(__('Order Placed')) ?>",
                "text": "<?= $escaper->escapeJs($text) ?>"
            }
        }
    }
</script>
