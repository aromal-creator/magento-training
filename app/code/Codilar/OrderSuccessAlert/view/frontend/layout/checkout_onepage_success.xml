<?xml version="1.0"?>
<!-- Checkout success page: adds the block that opens the order alert popup. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="codilar.order.success.alert"
                   template="Codilar_OrderSuccessAlert::order-alert.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\OrderSuccessAlert\ViewModel\OrderAlert</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
